{
  "name": "foundryscript",
  "displayName": "FoundryScript",
  "description": "FoundryScript language support for Visual Studio Code",
  "version": "0.1.0",
  "publisher": "cafecito-games",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cafecito-games/Foundry-Scripting.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [],
  "contributes": {
    "languages": [
      {
        "id": "foundryscript",
        "aliases": [
          "FoundryScript",
          "foundryscript"
        ],
        "extensions": [
          ".fs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "foundryscript",
        "scopeName": "source.foundryscript",
        "path": "./syntaxes/foundryscript.tmLanguage.json"
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "final",
        "description": "Marks a final FoundryScript declaration."
      }
    ],
    "commands": [
      {
        "command": "foundryScript.connectionActions",
        "title": "Show Language Server Connection Actions",
        "category": "FoundryScript"
      }
    ],
    "taskDefinitions": [
      {
        "type": "foundryscript",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "lint",
              "test",
              "format",
              "run"
            ],
            "description": "Foundry CLI command to run for the workspace project."
          }
        }
      }
    ],
    "configuration": {
      "title": "FoundryScript",
      "properties": {
        "foundryScript.lsp.mode": {
          "type": "string",
          "default": "spawn",
          "enum": [
            "spawn",
            "attach",
            "auto",
            "off"
          ],
          "description": "Choose whether the extension starts, attaches to, automatically selects, or disables the Foundry language server."
        },
        "foundryScript.lsp.port": {
          "type": "number",
          "default": 6005,
          "minimum": 1,
          "maximum": 65535,
          "description": "TCP port used to attach to an existing Foundry language server."
        },
        "foundryScript.enginePath": {
          "type": "string",
          "default": "foundry",
          "description": "Path to the Foundry executable used by the language server and workspace tasks."
        },
        "foundryScript.test.runner": {
          "type": "string",
          "default": "",
          "description": "Runner passed to foundry project test. Required by the FoundryScript test task."
        },
        "foundryScript.testing.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Foundry Test Adapter Protocol negotiation for future Test Explorer integration."
        },
        "foundryScript.testing.runner": {
          "type": "string",
          "default": "",
          "description": "Canonical res:// runner resource implementing the Foundry Test Adapter Protocol."
        },
        "foundryScript.testing.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Framework-specific arguments passed after the test adapter's reserved options."
        }
      }
    }
  },
  "scripts": {
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src",
    "test": "npm run test:unit && npm run test:grammar",
    "test:unit": "vitest run",
    "test:grammar": "vscode-tmgrammar-test \"tests/grammar/**/*.fs\" && node scripts/check-assertions.mjs",
    "test:corpus": "node scripts/check-corpus.mjs",
    "test:live-foundry": "node scripts/verify-foundry-test-run.mjs",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@types/vscode": "^1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "^0.24.0",
    "eslint": "^9.0.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageclient": "^9.0.1",
    "yaml": "2.9.0"
  }
}
