{
  "name": "foundryscript",
  "displayName": "FoundryScript",
  "description": "FoundryScript language support for Visual Studio Code",
  "version": "0.1.0",
  "publisher": "cafecito-games",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/cafecito-games/Foundry-Scripting.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "capabilities": {
    "untrustedWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting remains available. Foundry processes, tasks, tests, and debugging require workspace trust.",
      "restrictedConfigurations": [
        "foundryScript.lsp.mode",
        "foundryScript.lsp.port",
        "foundryScript.dap.port",
        "foundryScript.enginePath",
        "foundryScript.projectPath",
        "foundryScript.test.runner",
        "foundryScript.testing.enabled",
        "foundryScript.testing.runner",
        "foundryScript.testing.args"
      ]
    },
    "virtualWorkspaces": {
      "supported": "limited",
      "description": "Syntax highlighting and language configuration remain available. Native Foundry tooling requires a local file workspace."
    }
  },
  "categories": [
    "Programming Languages"
  ],
  "main": "./dist/extension.js",
  "activationEvents": [
    "onLanguage:foundryscript",
    "onCommand:foundryScript.connectionActions",
    "onTaskType:foundryscript",
    "onDebugInitialConfigurations",
    "onDebugResolve:foundryscript",
    "workspaceContains:**/project.foundry"
  ],
  "contributes": {
    "languages": [
      {
        "id": "foundryscript",
        "aliases": [
          "FoundryScript",
          "foundryscript"
        ],
        "extensions": [
          ".fs"
        ],
        "configuration": "./language-configuration.json"
      }
    ],
    "grammars": [
      {
        "language": "foundryscript",
        "scopeName": "source.foundryscript",
        "path": "./syntaxes/foundryscript.tmLanguage.json"
      }
    ],
    "breakpoints": [
      {
        "language": "foundryscript"
      }
    ],
    "debuggers": [
      {
        "type": "foundryscript",
        "label": "FoundryScript",
        "languages": [
          "foundryscript"
        ],
        "configurationAttributes": {
          "launch": {
            "required": [
              "scene"
            ],
            "properties": {
              "scene": {
                "description": "Foundry scene to launch. Use main for the project's configured main scene or a canonical res:// path to a .tscn scene.",
                "oneOf": [
                  {
                    "const": "main",
                    "description": "Launch the project's configured main scene."
                  },
                  {
                    "type": "string",
                    "pattern": "^res:\\/\\/(?:(?!\\.{1,2}(?:\\/|$))[^\\\\/]+\\/)*(?!\\.{1,2}(?:\\/|$))[^\\\\/]+\\.tscn$",
                    "patternErrorMessage": "Scene must be main or a canonical res:// path ending in .tscn.",
                    "description": "Launch an explicit scene using a canonical res:// path ending in .tscn."
                  }
                ]
              },
              "args": {
                "type": "array",
                "items": {
                  "type": "string"
                },
                "default": [],
                "description": "Additional string arguments passed to the launched Foundry scene."
              }
            }
          }
        },
        "initialConfigurations": [
          {
            "type": "foundryscript",
            "request": "launch",
            "name": "Debug Foundry Project",
            "scene": "main",
            "args": []
          }
        ],
        "configurationSnippets": [
          {
            "label": "FoundryScript: Debug Main Scene",
            "description": "Debug the Foundry project's configured main scene.",
            "body": {
              "type": "foundryscript",
              "request": "launch",
              "name": "Debug Foundry Project",
              "scene": "main",
              "args": []
            }
          },
          {
            "label": "FoundryScript: Debug Explicit Scene",
            "description": "Debug an explicit Foundry scene selected by res:// path.",
            "body": {
              "type": "foundryscript",
              "request": "launch",
              "name": "Debug Foundry Scene",
              "scene": "res://levels/forest.tscn",
              "args": []
            }
          }
        ]
      }
    ],
    "semanticTokenModifiers": [
      {
        "id": "final",
        "description": "Marks a final FoundryScript declaration."
      }
    ],
    "commands": [
      {
        "command": "foundryScript.connectionActions",
        "title": "Show Language Server Connection Actions",
        "category": "FoundryScript",
        "enablement": "isWorkspaceTrusted && !virtualWorkspace"
      }
    ],
    "taskDefinitions": [
      {
        "type": "foundryscript",
        "required": [
          "command"
        ],
        "properties": {
          "command": {
            "type": "string",
            "enum": [
              "build",
              "lint",
              "test",
              "format",
              "run"
            ],
            "description": "Foundry CLI command to run for the workspace project."
          }
        }
      }
    ],
    "configuration": {
      "title": "FoundryScript",
      "properties": {
        "foundryScript.lsp.mode": {
          "type": "string",
          "default": "spawn",
          "enum": [
            "spawn",
            "attach",
            "auto",
            "off"
          ],
          "description": "Choose whether the extension starts, attaches to, automatically selects, or disables the Foundry language server."
        },
        "foundryScript.lsp.port": {
          "type": "integer",
          "default": 6005,
          "minimum": 1,
          "maximum": 65535,
          "description": "TCP port used to attach to an existing Foundry language server."
        },
        "foundryScript.dap.port": {
          "type": "integer",
          "default": 6006,
          "minimum": 1,
          "maximum": 65535,
          "description": "TCP port used to connect to the Foundry debug adapter in an externally owned tooling host."
        },
        "foundryScript.enginePath": {
          "type": "string",
          "default": "foundry",
          "description": "Path to the Foundry executable used by the language server and workspace tasks."
        },
        "foundryScript.projectPath": {
          "type": "string",
          "default": "",
          "description": "Foundry project directory. Relative paths resolve from the first workspace folder. When empty, a root project.foundry is preferred, otherwise exactly one nested project is selected; multiple nested projects require this setting."
        },
        "foundryScript.test.runner": {
          "type": "string",
          "default": "",
          "description": "Runner passed to foundry project test. Required by the FoundryScript test task."
        },
        "foundryScript.testing.enabled": {
          "type": "boolean",
          "default": false,
          "description": "Enable Foundry Test Explorer discovery, run, and debug integration."
        },
        "foundryScript.testing.runner": {
          "type": "string",
          "default": "",
          "description": "Canonical res:// runner resource implementing the Foundry Test Adapter Protocol."
        },
        "foundryScript.testing.args": {
          "type": "array",
          "default": [],
          "items": {
            "type": "string"
          },
          "description": "Framework-specific arguments passed after the test adapter's reserved options."
        }
      }
    }
  },
  "scripts": {
    "vscode:prepublish": "npm run build",
    "build": "node esbuild.mjs",
    "watch": "node esbuild.mjs --watch",
    "typecheck": "tsc --noEmit && npm run typecheck:strict-production",
    "typecheck:strict-production": "tsc --project tsconfig.production-strict.json",
    "lint": "eslint src",
    "test": "npm run test:unit && npm run test:grammar",
    "test:unit": "vitest run",
    "test:grammar": "vscode-tmgrammar-test \"tests/grammar/**/*.fs\" && node scripts/check-assertions.mjs",
    "test:corpus": "node scripts/check-corpus.mjs",
    "test:live-foundry": "node scripts/verify-foundry-test-run.mjs",
    "test:dap-conformance": "node scripts/run-dap-conformance.mjs",
    "test:vscode-minimum": "node scripts/run-vscode-minimum.mjs",
    "test:vscode-integration": "node scripts/run-vscode-integration.mjs",
    "sync-grammar": "node scripts/sync-grammar.mjs",
    "check:grammar-sync": "node scripts/sync-grammar.mjs --check",
    "check:package-files": "node scripts/check-package-files.mjs",
    "audit:production": "npm audit --omit=dev",
    "audit:development": "npm audit --audit-level=moderate",
    "package": "vsce package"
  },
  "devDependencies": {
    "@types/node": "20.9.0",
    "@types/vscode": "1.90.0",
    "@typescript-eslint/eslint-plugin": "^8.0.0",
    "@typescript-eslint/parser": "^8.0.0",
    "@vscode/test-electron": "2.5.2",
    "@vscode/vsce": "^3.0.0",
    "esbuild": "0.28.1",
    "eslint": "^10.8.0",
    "typescript": "7.0.2",
    "vite": "6.4.3",
    "vitest": "4.1.10",
    "vscode-oniguruma": "^2.0.1",
    "vscode-textmate": "^9.1.0",
    "vscode-tmgrammar-test": "^0.1.3"
  },
  "dependencies": {
    "vscode-jsonrpc": "^8.2.0",
    "vscode-languageclient": "^9.0.1",
    "yaml": "2.9.0"
  }
}
