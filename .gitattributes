# Keep grammar fixtures and FoundryScript sources LF on every platform.
# A stray CR reaching the TextMate scanner turns a line-continuation
# backslash into invalid.illegal.unknown-escape and cascades from there.
*.fs text eol=lf
*.json text eol=lf

# Invalid protocol fixtures intentionally contain malformed encodings and endings.
src/testing/fixtures/discovery/invalid/*.jsonl binary
src/testing/fixtures/protocol-v1/**/*.tap binary
