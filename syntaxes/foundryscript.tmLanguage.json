      "contentName": "meta.dictionary.key.foundryscript",
      "begin": "(?:^[ \\t]*|(?<=[{,])[ \\t]{0,4})(?=[^\\s,:}#@])(?!(?:breakpoint|class_name|trait_name|tuple_name|enum_name|namespace|abstract|continue|extends|assert|import|return|signal|static|break|class|const|final|match|trait|tuple|while|yield|elif|else|enum|pass|uses|void|when|and|for|var|as|if|in|is|or)\\b)",
